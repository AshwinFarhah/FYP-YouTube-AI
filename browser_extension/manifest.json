{
  "manifest_version": 3,
  "name": "NeuroShield AI",
  "version": "1.0.0",
  "description": "Explainable Multimodal AI Browser Extension for Developmental Impact Analysis of Children's YouTube Content.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://youtube.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "NeuroShield AI",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/logo1.png",
    "32": "icons/logo1.png",
    "48": "icons/logo1.png",
    "128": "icons/logo1.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/logo.png",
        "icons/cognitive.png",
        "icons/behavioural.png",
        "icons/emotional.png",
        "icons/overall.png",
        "icons/explainability.png",
        "icons/engagement.png",
        "icons/visual.png",
        "icons/textual.png",
        "icons/audio.png",
        "icons/emotion-feature.png",
        "icons/metadata.png",
        "content/overlay.html",
        "settings/settings.html",
        "settings/settings.css"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "settings/settings.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css",
        "settings/settings.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
